# App (NODE_ENV is set by Next itself: `next dev` = development, `next build`/`next start` = production)
BASE_DOMAIN=brandcanvas.app
AUTH_SECRET=change-me-min-16-chars

# Database (app role must be NON-superuser and NOT have BYPASSRLS — see ADR 0002)
DATABASE_URL=postgres://brandcanvas_app:password@localhost:5432/brandcanvas
APP_DB_ROLE=brandcanvas_app

# Object store (S3-compatible; MinIO locally). Optional — mock storage works without it.
STORAGE_ENDPOINT=               # R2: https://<account>.r2.cloudflarestorage.com · MinIO: http://localhost:9000 · empty for AWS
STORAGE_REGION=us-east-1        # `auto` for R2
# STORAGE_FORCE_PATH_STYLE=true  # default: true with a custom endpoint
STORAGE_BUCKET=brandcanvas-assets
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Providers — all default to 'mock' so the app runs with zero external services.
IMAGE_PROVIDER=mock            # mock | fal | replicate | openai | gemini  (confirm at wire-up, ADR 0004)
IMAGE_PROVIDER_API_KEY=
BG_REMOVAL_PROVIDER=mock       # mock | local | remove_bg
CRM_PROVIDER=mock              # mock | email | webhook | hubspot | salesforce

# Render pipeline / limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Owner/migration role — used ONLY by migrations, policies, seed provisioning and the RLS test.
# Never used by the running app.
MIGRATION_DATABASE_URL=postgres://postgres:password@localhost:5432/brandcanvas

# App runtime (ADR 0006)
DATA_MODE=memory               # memory (seeded demo tenants, no DB) | postgres
STORAGE_DRIVER=local           # local | memory | s3 (AWS S3, R2, MinIO — private bucket)
LOCAL_STORAGE_DIR=.data/storage
TRUST_PROXY=false              # true only behind a proxy that sets X-Forwarded-For
MAX_UPLOAD_MB=10
UPLOAD_RATE_MAX=20             # uploads per client per RATE_LIMIT_WINDOW_MS
# RATE_LIMIT_STORE=postgres    # default with DATA_MODE=postgres: counters shared by all instances (ADR 0010)
PROOF_RATE_MAX=240             # proof RENDERS (cache misses) per client per window
LEAD_RATE_MAX=10               # lead submissions per client per window

# Tenant secrets at rest (ADR 0008). id:base64key[,id:oldkey] — first key seals, all keys open.
# openssl rand -base64 32
SETTINGS_ENCRYPTION_KEYS=
DELIVERY_WORKER=inline         # inline: CRM retries + maintenance in-process | off: cron `npm run jobs:deliveries` + `npm run jobs:maintenance`
DELIVERY_WORKER_INTERVAL_MS=30000
MAINTENANCE_INTERVAL_MS=3600000   # expired sign-in tokens, sessions and rate-limit windows
PROOF_WORKER=inline            # inline: pre-render proofs in this process | after: right after the upload request (serverless, ADR 0018) | off: `npm run jobs:proofs -- --watch`
PROOF_WORKER_INTERVAL_MS=15000
SUPPLIER_WORKER=inline         # inline: run supplier syncs in this process | after: right after the request (serverless, ADR 0018) | off: `npm run jobs:suppliers`
SUPPLIER_WORKER_INTERVAL_MS=300000
CRON_SECRET=                   # serverless only: 32+ chars; Vercel Cron sends it to /api/cron/<job> (ADR 0018)
PROMOSTANDARDS_FAKE_SUPPLIER=false  # dev/tests only: https://promostandards.example answers as a fake supplier

# Admin sign-in (ADR 0008): magic links by email.
EMAIL_PROVIDER=log             # log (dev: links printed to console) | resend
RESEND_API_KEY=
EMAIL_FROM="BrandCanvas <no-reply@brandcanvas.app>"
PUBLIC_BASE_URL=http://localhost:3000   # dev/path-mode links; leave empty in production (tenant hosts)
ADMIN_SIGNIN_RATE_MAX=10       # sign-in + verify attempts per client per window
SEED_ADMIN_EMAIL=               # optional: owner of the demo tenant created by db:seed
